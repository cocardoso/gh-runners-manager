#!/usr/bin/env bash
# A fake of the Proxmox VE command-line tools for the installer tests. It keeps its state
# as plain files in $FAKE_STATE and logs every call to $FAKE_LOG.
set -u
cmd=$(basename "$0")
S=${FAKE_STATE:?}
echo "$cmd $*" >>"${FAKE_LOG:?}"
touch "$S/pools" "$S/roles" "$S/users" "$S/tokens" "$S/storages" "$S/zones" "$S/vnets" "$S/subnets" "$S/groups" "$S/guests" "$S/images" "$S/ct_files" "$S/ct_secrets"

list() { # list FILE KEY: a JSON list of {"KEY":"line"}
  local first=1
  printf '['
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    [ $first = 1 ] || printf ','
    printf '{"%s":"%s"}' "$2" "$l"
    first=0
  done <"$1"
  printf ']\n'
}
opt() { # opt NAME ARGS...: the value after --NAME
  local n=$1; shift
  while [ $# -gt 0 ]; do [ "$1" = "--$n" ] && { echo "$2"; return; }; shift; done
}
has() { grep -qxF "$2" "$S/$1"; }

case $cmd in
id) echo 0 ;;
hostname) echo pve ;;
pveversion) echo "${FAKE_PVEVERSION:-pve-manager/9.2.21/0123456789abcdef (running kernel: 7.0.14-pve)}" ;;
openssl)
  case $1 in
    x509) echo "sha256 Fingerprint=AA:BB:CC" ;;
    rand) echo 0123456789abcdef0123456789abcdef ;;
  esac ;;
ip) echo "1.1.1.1 via 192.0.2.1 dev vmbr0 src 192.0.2.6 uid 0" ;;
curl)
  out=$(opt o "$@")
  url=${*: -1}
  if [ -n "$out" ]; then
    case $url in
      *SHA256SUMS) printf 'x  ghrm-linux-amd64\nx  ghrm-agent-linux-amd64\n' >"$out" ;;
      *) echo "binary from $url" >"$out" ;;
    esac
  fi ;;
sha256sum) cat >/dev/null; exit 0 ;;
dpkg) [ -f "$S/dnsmasq" ]; exit $? ;;
apt-get) [[ " $* " == *" dnsmasq "* ]] && touch "$S/dnsmasq"; exit 0 ;;
systemctl | sleep | mkdir) exit 0 ;;
pvesm) [ "$1" = add ] && echo "$3" >>"$S/storages"; exit 0 ;;
pveam)
  case $1 in
    list) sed -n "s|^$2:\(.*\)|$2:\1 100MB|p" "$S/images" ;;
    available) printf 'system          debian-13-standard_13.1-2_amd64.tar.zst\nsystem          ubuntu-24.04-standard_24.04-2_amd64.tar.zst\n' ;;
    download) echo "$2:vztmpl/$3" >>"$S/images" ;;
  esac ;;
pveum)
  case "$1 $2" in
    "pool add") echo "$3" >>"$S/pools" ;;
    "role add") echo "$3" >>"$S/roles" ;;
    "user add") echo "$3" >>"$S/users" ;;
    "user token")
      case $3 in
        add) echo "$4 $5" >>"$S/tokens"; echo '{"full-tokenid":"'"$4!$5"'","info":{"privsep":"0"},"value":"secret-123"}' ;;
        remove) grep -vxF "$4 $5" "$S/tokens" >"$S/tokens.new"; mv "$S/tokens.new" "$S/tokens" ;;
      esac ;;
  esac ;;
pvesh)
  verb=$1 path=$2; shift 2
  case "$verb $path" in
    "get /pools") list "$S/pools" poolid ;;
    "get /access/roles") list "$S/roles" roleid ;;
    "get /access/users") list "$S/users" userid ;;
    "get /access/users/"*/token) u=${path#/access/users/}; u=${u%/token}; sed -n "s|^$u ||p" "$S/tokens" >"$S/.tmp"; list "$S/.tmp" tokenid ;;
    "get /storage") list "$S/storages" storage ;;
    "get /cluster/sdn/zones") list "$S/zones" zone ;;
    "get /cluster/sdn/vnets") list "$S/vnets" vnet ;;
    "get /cluster/sdn/vnets/"*/subnets) list "$S/subnets" cidr ;;
    "get /cluster/firewall/options") printf '{"enable":%s,"policy_in":"ACCEPT"}\n' "$(cat "$S/fw_enable" 2>/dev/null || echo 0)" ;;
    "get /cluster/firewall/groups") list "$S/groups" group ;;
    "get /cluster/firewall/groups/"*) g=${path##*/}; touch "$S/group_$g"; list "$S/group_$g" dest ;;
    "get /cluster/resources")
      first=1; printf '['
      while read -r vmid tags _; do
        [ -n "$vmid" ] || continue
        [ $first = 1 ] || printf ','
        printf '{"type":"lxc","vmid":%s,"tags":"%s"}' "$vmid" "$tags"; first=0
      done <"$S/guests"; printf ']\n' ;;
    "get /cluster/nextid")
      n=100; while grep -q "^$n " "$S/guests"; do n=$((n + 1)); done; echo $n ;;
    "create /cluster/sdn/zones") opt zone "$@" >>"$S/zones" ;;
    "create /cluster/sdn/vnets") opt vnet "$@" >>"$S/vnets" ;;
    "create /cluster/sdn/vnets/"*/subnets) opt subnet "$@" >>"$S/subnets" ;;
    "create /cluster/firewall/groups") opt group "$@" >>"$S/groups" ;;
    "create /cluster/firewall/groups/"*) g=${path##*/}; d=$(opt dest "$@"); [ -n "$d" ] && echo "$d" >>"$S/group_$g" ;;
    "set /cluster/firewall/options") opt enable "$@" >"$S/fw_enable" ;;
  esac ;;
pct)
  sub=$1 vmid=${2:-}
  case $sub in
    status) grep -q "^$vmid " "$S/guests" || { echo "Configuration file 'nodes/pve/lxc/$vmid.conf' does not exist" >&2; exit 2; }; echo "status: running" ;;
    create) shift 3; echo "$vmid $(opt tags "$@") stopped" >>"$S/guests" ;;
    set) t=$(opt tags "${@:3}"); [ -n "$t" ] && sed -i.bak "s/^$vmid [^ ]*/$vmid $t/" "$S/guests" ;;
    push) echo "$vmid $4" >>"$S/ct_files" ;;
    exec)
      shift 3 # pct exec VMID --
      line="$*"
      case $line in
        "test -f "* | "test -s "*) has ct_files "$vmid ${line##* }"; exit $? ;;
        *"ghrm secret list"*) sed -n "s|^$vmid ||p" "$S/ct_secrets" ;;
        *"token_secret_file"*) grep -qxF "$vmid token_secret_file" "$S/ct_config" 2>/dev/null; exit $? ;;
        *"ghrm secret set"*) cat >/dev/null; echo "$vmid ${line##* }" >>"$S/ct_secrets" ;;
        *"ghrm version") echo "ghrm v9.9.9-test (abc)" ;;
        *"cat /var/lib/ghrm/setup-token") echo setup-token-xyz ;;
        "bash -s") cat >/dev/null ;;
        *"ip -4 -o addr"*) echo 192.0.2.20 ;;
      esac ;;
  esac ;;
esac
exit 0
